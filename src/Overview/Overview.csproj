<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Overview</AssemblyName>
    <RootNamespace>Overview</RootNamespace>
    <StartupObject>Overview.App</StartupObject>
    <ApplicationIcon>Assets\overview.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.9.2</Version>
    <Product>Overview</Product>
    <Company>Hoppsann</Company>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Single-file: unpack once to %TEMP%\.net\Overview and load from there on later starts,
         instead of decompressing the whole bundle on every start. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <Description>GNOME-style Activities overview for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\overview.ico" LogicalName="overview.ico" />
  </ItemGroup>

</Project>
